<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="9.0" ExtensionBundleId="com.peppa.motiontools" ExtensionBundleVersion="1.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.peppa.motiontools.prefix" Version="1.0.0" />
    <Extension Id="com.peppa.motiontools.anim" Version="1.0.0" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="PHXS" Version="[19.0,99.9]" />
      <Host Name="PHSP" Version="[19.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="9.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.peppa.motiontools.prefix">
      <DispatchInfo>
        <Resources>
          <MainPath>./prefix.html</MainPath>
          <ScriptPath>./host.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--disable-gpu</Parameter>
            <Parameter>--disable-gpu-compositing</Parameter>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>佩佩動態前綴</Menu>
          <Geometry>
            <Size><Width>260</Width><Height>420</Height></Size>
            <MinSize><Width>200</Width><Height>240</Height></MinSize>
            <MaxSize><Width>800</Width><Height>1200</Height></MaxSize>
          </Geometry>
          <Icons>
            <Icon Type="Normal">./icons/cat_light.png</Icon>
            <Icon Type="RollOver">./icons/cat_light_hover.png</Icon>
            <Icon Type="DarkNormal">./icons/cat_dark.png</Icon>
            <Icon Type="DarkRollOver">./icons/cat_dark_hover.png</Icon>
          </Icons>
        </UI>
      </DispatchInfo>
    </Extension>
  
    <Extension Id="com.peppa.motiontools.anim">
      <DispatchInfo>
        <Resources>
          <MainPath>./anim.html</MainPath>
          <ScriptPath>./host.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--disable-gpu</Parameter>
            <Parameter>--disable-gpu-compositing</Parameter>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>佩佩PS動畫</Menu>
          <Geometry>
            <Size><Width>260</Width><Height>420</Height></Size>
            <MinSize><Width>200</Width><Height>240</Height></MinSize>
            <MaxSize><Width>800</Width><Height>1200</Height></MaxSize>
          </Geometry>
          <Icons>
            <Icon Type="Normal">./icons/cat_light.png</Icon>
            <Icon Type="RollOver">./icons/cat_light_hover.png</Icon>
            <Icon Type="DarkNormal">./icons/cat_dark.png</Icon>
            <Icon Type="DarkRollOver">./icons/cat_dark_hover.png</Icon>
          </Icons>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
